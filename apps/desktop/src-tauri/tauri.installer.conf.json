{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Zach Snow",
    "copyright": "Copyright (c) 2026 Zach Snow",
    "shortDescription": "Local meeting recorder that knows who's talking",
    "resources": {
      "installer/engine/": "engine/",
      "installer/uv/": "uv/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/installer-hooks.nsh",
        "customLanguageFiles": { "English": "windows/installer-english.nsh" },
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
